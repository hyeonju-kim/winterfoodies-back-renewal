<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.winter.winter_back.domain.order.dao.OrderHistoryDao">

    <!-- ResultMap 정의 -->
    <resultMap id="OrderHistoryDtoMap" type="com.winter.winter_back.domain.order.dto.OrderHistoryDto">
        <id property="historyId" column="history_id"/>
        <result property="orderId" column="order_id"/>
        <result property="status" column="status"/>
        <result property="description" column="description"/>
        <result property="createdDatetime" column="created_datetime"/>
        <result property="createdBy" column="created_by"/>
    </resultMap>

    <!-- 주문 히스토리 생성 -->
    <insert id="insertOrderHistory" parameterType="com.winter.winter_back.domain.order.dto.OrderHistoryDto" useGeneratedKeys="true" keyProperty="historyId">
        INSERT INTO tb_order_history (
            order_id,
            status,
            description,
            created_datetime,
            created_by
        ) VALUES (
                     #{orderId},
                     #{status},
                     #{description},
                     #{createdDatetime},
                     #{createdBy}
                 )
    </insert>

    <!-- 주문 히스토리 목록 조회 -->
    <select id="selectOrderHistories" parameterType="string" resultMap="OrderHistoryDtoMap">
        SELECT
            history_id,
            order_id,
            status,
            description,
            created_datetime,
            created_by
        FROM tb_order_history
        WHERE order_id = #{orderId}
        ORDER BY created_datetime ASC
    </select>

    <!-- 최신 주문 히스토리 조회 -->
    <select id="selectLatestOrderHistory" parameterType="string" resultMap="OrderHistoryDtoMap">
        SELECT
            history_id,
            order_id,
            status,
            description,
            created_datetime,
            created_by
        FROM tb_order_history
        WHERE order_id = #{orderId}
        ORDER BY created_datetime DESC
        LIMIT 1
    </select>

    <!-- 주문 히스토리 삭제 -->
    <delete id="deleteOrderHistories" parameterType="string">
        DELETE FROM tb_order_history
        WHERE order_id = #{orderId}
    </delete>

</mapper>