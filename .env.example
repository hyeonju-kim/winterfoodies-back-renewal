# 로컬 실행용 환경변수 예시. 이 파일을 .env 로 복사한 뒤 값을 채운다 (.env 는 커밋 금지)
# docker-compose 와 Spring Boot(spring.config.import) 가 같이 읽는다

# 로컬 도커 MariaDB root 비밀번호 (docker-compose)
DB_ROOT_PASSWORD=
# 애플리케이션 DB 접속 비밀번호 (로컬은 DB_ROOT_PASSWORD 와 같은 값)
DB_PASSWORD=
# JWT 서명 키 (HS512, 64바이트 이상 Base64). 생성: openssl rand -base64 64
JWT_SECRET=

# 선택: 기본값을 바꿀 때만 지정
# DB_URL=jdbc:mariadb://localhost:3307/winter_app?allowPublicKeyRetrieval=true&useSSL=false
# DB_USERNAME=root
# SQL 로그(바인딩 값 포함) 출력 - 로컬 개발에서만 true
# SQL_LOG_ENABLED=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# 브라우저 호출 허용 출처 (기본: localhost·127.0.0.1 모든 포트)
# CORS_ALLOWED_ORIGINS=https://app.example.com,http://localhost:*
